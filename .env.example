# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty unless you have enabled analytics and users have opted in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Gmail SMTP (for contact form)
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Cloudflare Turnstile (contact form bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Optional in production for shared contact rate limiting; leave empty to use the bounded fallback
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
