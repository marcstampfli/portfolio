    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^16.3.3",
    "nodemailer": "^9.0.6",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.53.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "overrides": {
